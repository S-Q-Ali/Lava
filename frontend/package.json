{
  "name": "lava-studio-frontend",
  "private": true,
  "version": "0.1.0-beta.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
